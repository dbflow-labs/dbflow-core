* text=auto
*.sh text eol=lf
*.php text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Exclude development-only paths from Composer and GitHub source archives.
# composer.lock remains tracked in Git but is omitted from exported archives.
/.github export-ignore
/tests export-ignore
/docs export-ignore
/build export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpunit.xml export-ignore
/phpstan.neon export-ignore
/phpstan.neon.dist export-ignore
/composer.lock export-ignore
/RELEASE-NOTES-*.md export-ignore
/UPGRADE-*.md export-ignore
